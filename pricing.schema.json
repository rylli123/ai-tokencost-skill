{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/<your-org>/dsh-usage-cost/pricing.schema.json",
  "title": "dsh-usage-cost pricing catalog",
  "type": "object",
  "required": ["version", "updatedAt", "unit", "rates"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "unit": { "const": "per_million_tokens" },
    "defaultCurrency": { "enum": ["CNY", "USD"] },
    "rates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "provider", "label", "currency", "cacheHit", "cacheMiss", "output"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "provider": { "type": "string" },
          "label": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "currency": { "enum": ["CNY", "USD"] },
          "cacheHit": { "type": "number", "minimum": 0 },
          "cacheMiss": { "type": "number", "minimum": 0 },
          "cacheWrite": { "type": "number", "minimum": 0 },
          "output": { "type": "number", "minimum": 0 },
          "band": { "type": ["string", "null"] },
          "status": { "enum": ["verified", "unverified"] },
          "source": { "type": "string" },
          "checkedAt": { "type": "string" }
        }
      }
    },
    "bands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["peakMultiplier", "peakWindows"],
        "properties": {
          "timezoneOffsetMinutes": { "type": "integer" },
          "peakMultiplier": { "type": "number", "minimum": 1 },
          "offPeakMultiplier": { "type": "number", "minimum": 0 },
          "peakWindows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["weekdays", "start", "end"],
              "properties": {
                "weekdays": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 6 } },
                "start": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" },
                "end": { "type": "string", "pattern": "^\\d{2}:\\d{2}$" }
              }
            }
          },
          "holidays": { "type": "array", "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } },
          "source": { "type": "string" }
        }
      }
    },
    "extras": { "type": "array" }
  }
}
